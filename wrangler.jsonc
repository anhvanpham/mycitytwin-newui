{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycitytwin-newui",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./releases",
    "binding": "ASSETS",
    "run_worker_first": [
      "/future-api/*",
      "/road-disruptions-api",
      "/road-disruptions-api/*"
    ]
  },
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "FUTURE_DB",
      "database_name": "mycitytwin-future-plans",
      "database_id": "473e5634-290c-46fe-81fd-dfe6ea94029c"
    }
  ]
}
